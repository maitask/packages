{
  "name": "@maitask/stream-publisher",
  "version": "0.1.1",
  "description": "Publish NDJSON or SSE event streams to an HTTPS endpoint",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "homepage": "https://github.com/maitask/packages/tree/main/stream-publisher",
  "repository": {
    "type": "git",
    "url": "https://github.com/maitask/packages.git",
    "directory": "stream-publisher"
  },
  "bugs": {
    "url": "https://github.com/maitask/packages/issues"
  },
  "keywords": [
    "maitask",
    "stream",
    "http",
    "sse",
    "server-sent-events",
    "chunked",
    "real-time",
    "streaming",
    "ndjson",
    "websocket-alternative"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Stream Publisher",
  "category": "Communications & Automation",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Stream Publisher",
        "description": "Publish NDJSON or SSE event streams to an HTTPS endpoint",
        "category": "Communications & Automation",
        "keywords": [
          "maitask",
          "stream",
          "http",
          "sse",
          "server-sent-events",
          "chunked",
          "real-time",
          "streaming",
          "ndjson",
          "websocket-alternative"
        ]
      },
      "zh": {
        "display_name": "流发布器",
        "description": "向 HTTPS 端点发布 NDJSON 或 SSE 事件流。",
        "category": "通信与自动化",
        "keywords": [
          "流",
          "SSE",
          "Server-Sent Events",
          "分块传输",
          "实时",
          "NDJSON"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": [
          "array",
          "object"
        ],
        "title": "Events",
        "description": "Array of event payloads or a single event object to stream.",
        "items": {},
        "additionalProperties": true
      },
      "options": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "format": "uri"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "enum": [
              "chunked",
              "sse"
            ],
            "default": "chunked"
          },
          "event_name": {
            "type": "string",
            "title": "Event name"
          },
          "tokenSecret": {
            "type": "string",
            "title": "Token Secret"
          },
          "headers": {
            "type": "object",
            "title": "Headers",
            "additionalProperties": {
              "type": "string"
            },
            "x-advanced": true
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout (ms)",
            "minimum": 1,
            "maximum": 120000,
            "default": 30000,
            "x-advanced": true
          },
          "allowInsecureHttp": {
            "type": "boolean",
            "title": "Allow Insecure HTTP",
            "default": false,
            "x-advanced": true
          },
          "allowPrivateHosts": {
            "type": "boolean",
            "title": "Allow Private Hosts",
            "default": false,
            "x-advanced": true
          }
        },
        "required": [
          "url"
        ]
      }
    }
  }
}

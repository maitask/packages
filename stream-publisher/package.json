{
  "name": "@maitask/stream-publisher",
  "version": "0.1.1",
  "description": "Publish NDJSON or SSE event streams to an HTTPS endpoint",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "homepage": "https://github.com/maitask/packages/tree/main/stream-publisher",
  "repository": {
    "type": "git",
    "url": "https://github.com/maitask/packages.git",
    "directory": "stream-publisher"
  },
  "bugs": {
    "url": "https://github.com/maitask/packages/issues"
  },
  "keywords": [
    "maitask",
    "stream",
    "http",
    "sse",
    "server-sent-events",
    "chunked",
    "real-time",
    "streaming",
    "ndjson",
    "websocket-alternative"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Stream Publisher",
  "category": "Communications & Automation",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Stream Publisher",
        "description": "Publish NDJSON or SSE event streams to an HTTPS endpoint",
        "category": "Communications & Automation",
        "keywords": [
          "maitask",
          "stream",
          "http",
          "sse",
          "server-sent-events",
          "chunked",
          "real-time",
          "streaming",
          "ndjson",
          "websocket-alternative"
        ]
      },
      "zh": {
        "display_name": "流发布器",
        "description": "向 HTTPS 端点发布 NDJSON 或 SSE 事件流。",
        "category": "通信与自动化",
        "keywords": [
          "流",
          "SSE",
          "Server-Sent Events",
          "分块传输",
          "实时",
          "NDJSON"
        ]
      }
    },
    "schemas": {
      "options": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "default": "https://events.example.com/ingest",
            "format": "uri"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "sse"
          },
          "event_name": {
            "type": "string",
            "title": "Event name",
            "default": "maitask-event"
          },
          "tokenSecret": {
            "type": "string",
            "title": "Token Secret",
            "format": "password"
          }
        }
      }
    }
  }
}

{
  "name": "@maitask/github-integration",
  "version": "1.0.1",
  "description": "Credential-confined GitHub REST client for repositories, issues, pull requests, users, and controlled custom requests",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "github",
    "api",
    "git",
    "repository"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "GitHub Integration",
  "category": "Web & API Integration",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "GitHub Integration",
        "description": "Credential-confined GitHub REST client for repositories, issues, pull requests, users, and controlled custom requests",
        "category": "Web & API Integration",
        "keywords": [
          "maitask",
          "github",
          "api",
          "git",
          "repository"
        ]
      },
      "zh": {
        "display_name": "GitHub 集成",
        "description": "具备凭据来源限制的 GitHub REST 客户端，支持仓库、Issue、Pull Request、用户和受控自定义请求。",
        "category": "Web 与 API 集成",
        "keywords": [
          "GitHub",
          "API",
          "Git",
          "仓库",
          "Issue",
          "Pull Request"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "title": "Action",
            "default": "createIssue"
          },
          "owner": {
            "type": "string",
            "title": "Owner",
            "default": "acme"
          },
          "repository": {
            "type": "string",
            "title": "Repository",
            "default": "service"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "default": "Production incident follow-up"
          },
          "body": {
            "type": "string",
            "title": "Body",
            "default": "Track remediation and verification work."
          },
          "labels": {
            "type": "array",
            "title": "Labels",
            "items": {
              "type": "string",
              "title": "Labels",
              "default": "operations"
            }
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "default": 30000,
            "x-advanced": true
          },
          "maxResponseBytes": {
            "type": "integer",
            "title": "Max Response Bytes",
            "default": 4194304,
            "x-advanced": true
          }
        }
      }
    }
  }
}

{
  "name": "@maitask/web-scraper",
  "version": "0.1.1",
  "description": "Extract data from web pages with HTML parsing, CSS selectors, and XPath queries",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "homepage": "https://github.com/maitask/packages/tree/main/web-scraper",
  "repository": {
    "type": "git",
    "url": "https://github.com/maitask/packages.git",
    "directory": "web-scraper"
  },
  "bugs": {
    "url": "https://github.com/maitask/packages/issues"
  },
  "keywords": [
    "maitask",
    "web-scraping",
    "html-parser",
    "cheerio-style",
    "css-selector",
    "data-extraction"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Web Scraper",
  "category": "Web & API Integration",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Web Scraper",
        "description": "Extract data from web pages with HTML parsing, CSS selectors, and XPath queries",
        "category": "Web & API Integration",
        "keywords": [
          "maitask",
          "web-scraping",
          "html-parser",
          "cheerio-style",
          "css-selector",
          "data-extraction"
        ]
      },
      "zh": {
        "display_name": "网页抓取器",
        "description": "使用 HTML 解析、CSS 选择器和 XPath 查询从网页中提取数据。",
        "category": "Web 与 API 集成",
        "keywords": [
          "网页抓取",
          "HTML",
          "CSS 选择器",
          "XPath",
          "数据提取",
          "爬虫"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": [
          "object",
          "array",
          "string"
        ],
        "title": "Targets",
        "description": "Target URL string, target object ({ url, label }), or array of URLs/target objects.",
        "items": {},
        "properties": {
          "url": {
            "type": "string",
            "title": "URL",
            "format": "uri"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "href": {
            "type": "string",
            "title": "Href",
            "format": "uri",
            "x-advanced": true
          },
          "name": {
            "type": "string",
            "title": "Name",
            "x-advanced": true
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "selectors": {
            "type": "object",
            "title": "Selectors",
            "additionalProperties": true
          },
          "headingLevels": {
            "type": "array",
            "title": "Heading Levels",
            "items": {
              "type": "string"
            }
          },
          "linkFilters": {
            "type": "object",
            "title": "Link Filters",
            "properties": {
              "include": {
                "type": "array",
                "title": "Include",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "title": "Exclude",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "xpath": {
            "type": "object",
            "title": "XPath Selectors",
            "additionalProperties": {
              "type": "string"
            },
            "x-advanced": true
          },
          "patterns": {
            "type": "array",
            "title": "Patterns",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "x-advanced": true
          },
          "preserveWhitespace": {
            "type": "boolean",
            "title": "Preserve Whitespace",
            "default": false,
            "x-advanced": true
          },
          "headers": {
            "type": "object",
            "title": "Headers",
            "additionalProperties": {
              "type": "string"
            },
            "x-advanced": true
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout (ms)",
            "minimum": 1000,
            "maximum": 120000,
            "default": 30000,
            "x-advanced": true
          },
          "maxBytes": {
            "type": "integer",
            "title": "Max Bytes",
            "minimum": 1024,
            "maximum": 10485760,
            "default": 5242880,
            "x-advanced": true
          },
          "allowPrivateHosts": {
            "type": "boolean",
            "title": "Allow Private Hosts",
            "default": false,
            "x-advanced": true
          }
        }
      }
    }
  }
}

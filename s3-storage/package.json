{
  "name": "@maitask/s3-storage",
  "version": "0.1.1",
  "description": "Upload, download, or delete objects through presigned S3 URLs",
  "main": "index.js",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "s3",
    "storage",
    "aws",
    "upload",
    "download"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "S3 Storage",
  "category": "Export & Storage",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "S3 Storage",
        "description": "Upload, download, or delete objects through presigned S3 URLs",
        "category": "Export & Storage",
        "keywords": [
          "maitask",
          "s3",
          "storage",
          "aws",
          "upload",
          "download"
        ]
      },
      "zh": {
        "display_name": "S3 存储",
        "description": "通过预签名 URL 上传、下载或删除 S3 兼容对象。",
        "category": "导出与存储",
        "keywords": [
          "S3",
          "存储",
          "AWS",
          "上传",
          "下载",
          "对象存储"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "title": "Operation",
            "enum": [
              "list",
              "upload",
              "download",
              "delete"
            ]
          },
          "presignedUrl": {
            "type": "string",
            "title": "Presigned Url",
            "format": "uri"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "x-advanced": true,
            "minimum": 1,
            "maximum": 120000
          }
        },
        "required": [
          "operation",
          "presignedUrl"
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "default": 30000,
            "x-advanced": true,
            "minimum": 1,
            "maximum": 120000
          },
          "allowInsecureHttp": {
            "type": "boolean",
            "title": "Allow Insecure HTTP",
            "default": false,
            "x-advanced": true
          },
          "allowPrivateHosts": {
            "type": "boolean",
            "title": "Allow Private Hosts",
            "default": false,
            "x-advanced": true
          }
        }
      }
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ]
}

{
  "name": "@maitask/openai",
  "version": "0.1.2",
  "description": "OpenAI GPT models integration for Maitask",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "ai",
    "openai",
    "gpt",
    "llm",
    "chat"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "OpenAI",
  "category": "AI & Cognitive Services",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "OpenAI",
        "description": "OpenAI GPT models integration for Maitask",
        "category": "AI & Cognitive Services",
        "keywords": [
          "maitask",
          "ai",
          "openai",
          "gpt",
          "llm",
          "chat"
        ]
      },
      "zh": {
        "display_name": "OpenAI",
        "description": "OpenAI GPT 模型集成，用于聊天、文本生成、推理和智能自动化。",
        "category": "AI 与认知服务",
        "keywords": [
          "OpenAI",
          "GPT",
          "AI",
          "大语言模型",
          "聊天",
          "文本生成"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "gpt-4o-mini"
          },
          "messages": {
            "type": "array",
            "title": "Messages",
            "items": {
              "type": "object",
              "title": "Messages",
              "properties": {
                "role": {
                  "type": "string",
                  "title": "Role",
                  "default": "system"
                },
                "content": {
                  "type": "string",
                  "title": "Content",
                  "default": "You are a helpful engineering assistant."
                }
              }
            }
          },
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "default": 0.6,
            "x-advanced": true
          },
          "maxTokens": {
            "type": "integer",
            "title": "Max Tokens",
            "default": 500,
            "x-advanced": true
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "title": "Api Key",
            "format": "password"
          }
        }
      }
    }
  }
}

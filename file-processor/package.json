{
  "name": "@maitask/file-processor",
  "version": "0.1.1",
  "description": "Powerful data processing and transformation engine",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "homepage": "https://github.com/maitask/packages/tree/main/file-processor",
  "repository": {
    "type": "git",
    "url": "https://github.com/maitask/packages.git",
    "directory": "file-processor"
  },
  "bugs": {
    "url": "https://github.com/maitask/packages/issues"
  },
  "keywords": [
    "maitask",
    "processor",
    "data",
    "transformation",
    "pipeline",
    "filter",
    "aggregate",
    "etl",
    "processing"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "File Processor",
  "category": "Data Processing & Transformation",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "File Processor",
        "description": "Powerful data processing and transformation engine",
        "category": "Data Processing & Transformation",
        "keywords": [
          "maitask",
          "processor",
          "data",
          "transformation",
          "pipeline",
          "filter",
          "aggregate",
          "etl",
          "processing"
        ]
      },
      "zh": {
        "display_name": "文件处理器",
        "description": "通用数据处理与转换引擎，支持过滤、聚合、管道处理和 ETL 流程。",
        "category": "数据处理与转换",
        "keywords": [
          "文件处理",
          "数据转换",
          "管道",
          "过滤",
          "聚合",
          "ETL"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": [
          "object",
          "array",
          "string"
        ],
        "title": "Input Data",
        "description": "Array of records, JSON/line string, or wrapper object containing rows, records, or data.",
        "items": {
          "type": "object",
          "additionalProperties": true
        },
        "properties": {
          "rows": {
            "type": "array",
            "title": "Rows",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "records": {
            "type": "array",
            "title": "Records",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "x-advanced": true
          },
          "data": {
            "type": "array",
            "title": "Data",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "x-advanced": true
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "title": "Operation",
            "enum": [
              "transform",
              "filter",
              "aggregate",
              "pipeline"
            ],
            "default": "transform"
          },
          "pipeline": {
            "type": "array",
            "title": "Pipeline",
            "items": {
              "type": "object",
              "title": "Pipeline",
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Type"
                },
                "rules": {
                  "type": "array",
                  "title": "Rules",
                  "items": {
                    "type": "object",
                    "title": "Rules",
                    "properties": {
                      "field": {
                        "type": "string",
                        "title": "Field",
                        "default": "team"
                      },
                      "operator": {
                        "type": "string",
                        "title": "Operator",
                        "default": "eq"
                      },
                      "value": {
                        "type": "string",
                        "title": "Value",
                        "default": "Research"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

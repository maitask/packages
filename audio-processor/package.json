{
  "name": "@maitask/audio-processor",
  "version": "0.1.2",
  "description": "Audio transcription and speech synthesis through Whisper and OpenAI audio APIs",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "ai",
    "audio",
    "transcription",
    "whisper",
    "speech-to-text"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Audio Processor",
  "category": "Media & Multimodal Processing",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Audio Processor",
        "description": "Audio transcription and speech synthesis through Whisper and OpenAI audio APIs",
        "category": "Media & Multimodal Processing",
        "keywords": [
          "maitask",
          "ai",
          "audio",
          "transcription",
          "whisper",
          "speech-to-text",
          "speech-synthesis"
        ]
      },
      "zh": {
        "display_name": "音频处理器",
        "description": "通过 Whisper 与 OpenAI 音频接口进行转写与语音合成。",
        "category": "媒体与多模态处理",
        "keywords": [
          "音频",
          "转写",
          "语音转文本",
          "语音合成",
          "Whisper",
          "AI",
          "语音"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "audioUrl": {
            "type": "string",
            "title": "Audio Url",
            "default": "https://storage.googleapis.com/maitask/examples/meeting-snippet.mp3",
            "format": "uri"
          },
          "task": {
            "type": "string",
            "title": "Task",
            "default": "transcribe"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "en"
          },
          "provider": {
            "type": "string",
            "title": "Provider",
            "default": "whisper"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "whisper-1"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "default": "Transcribe the meeting and highlight action items for the team."
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "title": "Api Key",
            "format": "password"
          }
        }
      }
    }
  }
}

{
  "name": "@maitask/yaml-converter",
  "version": "0.1.1",
  "description": "YAML to JSON bidirectional converter",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "homepage": "https://github.com/maitask/packages/tree/main/yaml-converter",
  "repository": {
    "type": "git",
    "url": "https://github.com/maitask/packages.git",
    "directory": "yaml-converter"
  },
  "bugs": {
    "url": "https://github.com/maitask/packages/issues"
  },
  "keywords": [
    "maitask",
    "yaml",
    "json",
    "converter",
    "parser",
    "serializer"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "YAML Converter",
  "category": "Data Processing & Transformation",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "YAML Converter",
        "description": "YAML to JSON bidirectional converter",
        "category": "Data Processing & Transformation",
        "keywords": [
          "maitask",
          "yaml",
          "json",
          "converter",
          "parser",
          "serializer"
        ]
      },
      "zh": {
        "display_name": "YAML 转换器",
        "description": "YAML 与 JSON 双向转换工具，适合配置文件处理和序列化转换。",
        "category": "数据处理与转换",
        "keywords": [
          "YAML",
          "JSON",
          "转换器",
          "解析器",
          "序列化",
          "配置"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": [
          "object",
          "string",
          "array"
        ],
        "title": "YAML or JSON Input",
        "description": "YAML/JSON string, wrapper object ({ text, yaml, data, json }), or JSON object/array.",
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "format": "textarea"
          },
          "yaml": {
            "type": "string",
            "title": "YAML",
            "format": "textarea",
            "x-advanced": true
          },
          "data": {
            "type": "object",
            "title": "Data",
            "additionalProperties": true,
            "x-advanced": true
          },
          "json": {
            "type": "object",
            "title": "JSON",
            "additionalProperties": true,
            "x-advanced": true
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "title": "Direction",
            "enum": [
              "auto",
              "yaml-to-json",
              "json-to-yaml"
            ],
            "default": "auto"
          },
          "indent": {
            "type": "integer",
            "title": "Indent",
            "default": 2,
            "minimum": 1,
            "maximum": 16
          }
        }
      }
    }
  }
}

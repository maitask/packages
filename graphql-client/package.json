{
  "name": "@maitask/graphql-client",
  "version": "0.1.1",
  "description": "Execute GraphQL queries and mutations over HTTPS with secret-backed bearer tokens",
  "main": "index.js",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "graphql",
    "api",
    "query",
    "mutation"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "GraphQL Client",
  "category": "Web & API Integration",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "GraphQL Client",
        "description": "Execute GraphQL queries and mutations over HTTPS with secret-backed bearer tokens",
        "category": "Web & API Integration",
        "keywords": [
          "maitask",
          "graphql",
          "api",
          "query",
          "mutation"
        ]
      },
      "zh": {
        "display_name": "GraphQL 客户端",
        "description": "通过 HTTPS 执行 GraphQL 查询和变更，凭证使用 Runtime secrets 中的 bearer 令牌。",
        "category": "Web 与 API 集成",
        "keywords": [
          "GraphQL",
          "API",
          "查询",
          "Mutation",
          "客户端",
          "数据访问"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "format": "uri"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "variables": {
            "type": "object",
            "title": "Variables",
            "additionalProperties": true
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "x-advanced": true,
            "minimum": 1,
            "maximum": 120000
          }
        },
        "required": [
          "url",
          "query"
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "tokenSecret": {
            "type": "string",
            "title": "Bearer Token Secret Name",
            "x-advanced": true
          },
          "allowInsecureHttp": {
            "type": "boolean",
            "title": "Allow Insecure HTTP",
            "default": false,
            "x-advanced": true
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "default": 30000,
            "x-advanced": true,
            "minimum": 1,
            "maximum": 120000
          },
          "allowPrivateHosts": {
            "type": "boolean",
            "title": "Allow Private Hosts",
            "default": false,
            "x-advanced": true
          }
        }
      }
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ]
}

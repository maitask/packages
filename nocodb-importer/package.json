{
  "name": "@maitask/nocodb-importer",
  "version": "0.1.1",
  "description": "Import data to NocoDB with authentication",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "nocodb",
    "database",
    "import",
    "api"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "NocoDB Importer",
  "category": "Export & Storage",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "NocoDB Importer",
        "description": "Import data to NocoDB with authentication",
        "category": "Export & Storage",
        "keywords": [
          "maitask",
          "nocodb",
          "database",
          "import",
          "api"
        ]
      },
      "zh": {
        "display_name": "NocoDB 导入器",
        "description": "通过 API 将数据导入 NocoDB，并支持认证配置，适合低代码数据同步。",
        "category": "导出与存储",
        "keywords": [
          "NocoDB",
          "导入",
          "数据库",
          "API",
          "数据同步",
          "低代码"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "title": "Content",
            "default": "name,email,plan\nAlice,alice@example.com,Pro\nBob,bob@example.com,Free"
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "baseUrl": {
            "type": "string",
            "title": "Base Url",
            "default": "https://nocodb.example.com",
            "format": "uri"
          },
          "token": {
            "type": "string",
            "title": "Token",
            "format": "password"
          },
          "baseId": {
            "type": "string",
            "title": "Base Id",
            "default": "proj_123456"
          },
          "tableName": {
            "type": "string",
            "title": "Table Name",
            "default": "customers"
          },
          "dryRun": {
            "type": "boolean",
            "title": "Dry Run",
            "default": true
          },
          "delimiter": {
            "type": "string",
            "title": "Delimiter",
            "default": ","
          }
        }
      }
    }
  }
}

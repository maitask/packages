{
  "name": "@maitask/hackernews-crawler",
  "version": "0.1.1",
  "description": "Crawl and extract stories from Hacker News using official API",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "hackernews",
    "ycombinator",
    "crawler",
    "api"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Hacker News Crawler",
  "category": "Web & API Integration",
  "maitask": {
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "storyType": {
            "type": "string",
            "title": "Story list",
            "enum": ["top", "best", "new", "ask", "show", "job"],
            "default": "top"
          },
          "limit": {
            "type": "integer",
            "title": "Story count",
            "minimum": 1,
            "maximum": 100,
            "default": 30
          },
          "includeComments": {
            "type": "boolean",
            "title": "Include comments",
            "default": true
          },
          "commentLimit": {
            "type": "integer",
            "title": "Comments per story",
            "minimum": 0,
            "maximum": 50,
            "default": 5,
            "x-advanced": true
          },
          "commentDepth": {
            "type": "integer",
            "title": "Comment depth",
            "minimum": 1,
            "maximum": 5,
            "default": 1,
            "x-advanced": true
          }
        }
      }
    },
    "locales": {
      "en": {
        "display_name": "Hacker News Crawler",
        "description": "Crawl and extract stories from Hacker News using official API",
        "category": "Web & API Integration",
        "keywords": [
          "maitask",
          "hackernews",
          "ycombinator",
          "crawler",
          "api"
        ]
      },
      "zh": {
        "display_name": "Hacker News 抓取器",
        "description": "使用官方 API 抓取并提取 Hacker News 故事，适合内容收集和资讯分析。",
        "category": "Web 与 API 集成",
        "keywords": [
          "Hacker News",
          "抓取",
          "爬虫",
          "API",
          "资讯",
          "内容收集"
        ]
      }
    }
  }
}

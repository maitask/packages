{
  "name": "@maitask/web-search",
  "version": "0.1.2",
  "description": "Search the web using multiple search engines",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "search",
    "google",
    "bing",
    "web"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Web Search",
  "category": "Web & API Integration",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Web Search",
        "description": "Search the web using multiple search engines",
        "category": "Web & API Integration",
        "keywords": [
          "maitask",
          "search",
          "google",
          "bing",
          "web"
        ]
      },
      "zh": {
        "display_name": "网页搜索",
        "description": "使用多个搜索引擎搜索网页内容，适合资料检索和信息收集。",
        "category": "Web 与 API 集成",
        "keywords": [
          "网页搜索",
          "搜索引擎",
          "Google",
          "Bing",
          "检索",
          "信息收集"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "title": "Query",
            "default": "Artificial intelligence trends 2025"
          },
          "engine": {
            "type": "string",
            "title": "Engine",
            "enum": [
              "duckduckgo",
              "bing",
              "google"
            ],
            "default": "duckduckgo"
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 5
          },
          "page": {
            "type": "integer",
            "title": "Page",
            "default": 1,
            "x-advanced": true
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "en"
          },
          "includeSnippets": {
            "type": "boolean",
            "title": "Include Snippets",
            "default": true
          }
        }
      }
    }
  }
}

{
  "name": "@maitask/slack-notifier",
  "version": "0.1.1",
  "description": "Send notifications and messages to Slack channels via incoming webhooks",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "homepage": "https://github.com/maitask/packages/tree/main/slack-notifier",
  "repository": {
    "type": "git",
    "url": "https://github.com/maitask/packages.git",
    "directory": "slack-notifier"
  },
  "bugs": {
    "url": "https://github.com/maitask/packages/issues"
  },
  "keywords": [
    "maitask",
    "slack",
    "webhook",
    "notification",
    "messaging",
    "integration",
    "bot",
    "alerts"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Slack Notifier",
  "category": "Communications & Automation",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Slack Notifier",
        "description": "Send notifications and messages to Slack channels via incoming webhooks",
        "category": "Communications & Automation",
        "keywords": [
          "maitask",
          "slack",
          "webhook",
          "notification",
          "messaging",
          "integration",
          "bot",
          "alerts"
        ]
      },
      "zh": {
        "display_name": "Slack 通知器",
        "description": "通过 Incoming Webhook 向 Slack 频道发送通知和消息，适合告警与协作提醒。",
        "category": "通信与自动化",
        "keywords": [
          "Slack",
          "Webhook",
          "通知",
          "消息",
          "告警",
          "机器人"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "default": "Deployment succeeded :rocket:"
          },
          "blocks": {
            "type": "array",
            "title": "Blocks",
            "items": {
              "type": "object",
              "title": "Blocks",
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Type",
                  "default": "section"
                },
                "text": {
                  "type": "object",
                  "title": "Text",
                  "properties": {
                    "type": {
                      "type": "string",
                      "title": "Type",
                      "default": "mrkdwn"
                    },
                    "text": {
                      "type": "string",
                      "title": "Text",
                      "default": "*Service:* api-gateway\n*Version:* 1.4.2"
                    }
                  }
                }
              }
            }
          },
          "attachments": {
            "type": "array",
            "title": "Attachments",
            "items": {
              "type": "object",
              "title": "Attachments",
              "properties": {
                "color": {
                  "type": "string",
                  "title": "Color",
                  "default": "#36C5F0"
                },
                "fields": {
                  "type": "array",
                  "title": "Fields",
                  "items": {
                    "type": "object",
                    "title": "Fields",
                    "properties": {
                      "title": {
                        "type": "string",
                        "title": "Title",
                        "default": "Environment"
                      },
                      "value": {
                        "type": "string",
                        "title": "Value",
                        "default": "production"
                      },
                      "short": {
                        "type": "boolean",
                        "title": "Short",
                        "default": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": "#deployments"
          },
          "username": {
            "type": "string",
            "title": "Username",
            "default": "Maitask Bot"
          },
          "threadTs": {
            "type": "string",
            "title": "Thread Ts",
            "default": "1700000000.000001"
          },
          "iconEmoji": {
            "type": "string",
            "title": "Icon Emoji",
            "default": ":rocket:"
          },
          "linkNames": {
            "type": "boolean",
            "title": "Link Names",
            "default": true
          },
          "mrkdwn": {
            "type": "boolean",
            "title": "Mrkdwn",
            "default": true
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "default": 30000,
            "x-advanced": true
          }
        }
      }
    }
  }
}

{
  "name": "@maitask/email-sender",
  "version": "1.0.1",
  "description": "Credential-confined SendGrid and Mailgun delivery with safe templates and exact attachments",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "homepage": "https://github.com/maitask/packages/tree/main/email-sender",
  "repository": {
    "type": "git",
    "url": "https://github.com/maitask/packages.git",
    "directory": "email-sender"
  },
  "bugs": {
    "url": "https://github.com/maitask/packages/issues"
  },
  "keywords": [
    "maitask",
    "email",
    "sendgrid",
    "mailgun",
    "notification",
    "messaging",
    "templates",
    "communication"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Email Sender",
  "category": "Communications & Automation",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Email Sender",
        "description": "Credential-confined SendGrid and Mailgun delivery with safe templates and exact attachments",
        "category": "Communications & Automation",
        "keywords": [
          "maitask",
          "email",
          "sendgrid",
          "mailgun",
          "notification",
          "messaging",
          "templates",
          "communication"
        ]
      },
      "zh": {
        "display_name": "邮件发送器",
        "description": "具备凭据隔离、安全模板和精确附件的 SendGrid 与 Mailgun 邮件投递能力。",
        "category": "通信与自动化",
        "keywords": [
          "邮件",
          "SendGrid",
          "Mailgun",
          "通知",
          "模板",
          "消息"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider",
            "enum": [
              "sendgrid",
              "mailgun"
            ],
            "default": "sendgrid"
          },
          "from": {
            "type": "object",
            "title": "From",
            "properties": {
              "email": {
                "type": "string",
                "title": "Email"
              },
              "name": {
                "type": "string",
                "title": "Name"
              }
            }
          },
          "to": {
            "type": "array",
            "title": "To",
            "items": {
              "type": "object",
              "title": "Recipient",
              "properties": {
                "email": {
                  "type": "string",
                  "title": "Email"
                },
                "name": {
                  "type": "string",
                  "title": "Name"
                }
              }
            }
          },
          "cc": {
            "type": "array",
            "title": "CC",
            "items": {
              "type": "object",
              "title": "Recipient",
              "properties": {
                "email": {
                  "type": "string",
                  "title": "Email"
                },
                "name": {
                  "type": "string",
                  "title": "Name"
                }
              }
            },
            "x-advanced": true
          },
          "bcc": {
            "type": "array",
            "title": "BCC",
            "items": {
              "type": "object",
              "title": "Recipient",
              "properties": {
                "email": {
                  "type": "string",
                  "title": "Email"
                },
                "name": {
                  "type": "string",
                  "title": "Name"
                }
              }
            },
            "x-advanced": true
          },
          "replyTo": {
            "type": "object",
            "title": "Reply To",
            "properties": {
              "email": {
                "type": "string",
                "title": "Email"
              },
              "name": {
                "type": "string",
                "title": "Name"
              }
            },
            "x-advanced": true
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "content": {
            "type": "object",
            "title": "Content",
            "properties": {
              "text": {
                "type": "string",
                "title": "Text"
              },
              "html": {
                "type": "string",
                "title": "Html"
              }
            }
          },
          "template": {
            "type": "object",
            "title": "Template",
            "properties": {
              "text": {
                "type": "string",
                "title": "Text"
              },
              "html": {
                "type": "string",
                "title": "Html"
              },
              "variables": {
                "type": "object",
                "title": "Variables",
                "additionalProperties": true
              }
            }
          },
          "providerTemplate": {
            "type": "object",
            "title": "Provider Template",
            "properties": {
              "id": {
                "type": "string",
                "title": "Template ID"
              },
              "variables": {
                "type": "object",
                "title": "Variables",
                "additionalProperties": true
              }
            },
            "x-advanced": true
          },
          "attachments": {
            "type": "array",
            "title": "Attachments",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string",
                  "title": "Filename"
                },
                "contentType": {
                  "type": "string",
                  "title": "Content Type"
                },
                "bodyBase64": {
                  "type": "string",
                  "title": "Body Base64"
                },
                "disposition": {
                  "type": "string",
                  "title": "Disposition",
                  "enum": [
                    "attachment",
                    "inline"
                  ]
                },
                "contentId": {
                  "type": "string",
                  "title": "Content ID"
                }
              }
            },
            "x-advanced": true
          },
          "headers": {
            "type": "object",
            "title": "Headers",
            "additionalProperties": {
              "type": "string"
            },
            "x-advanced": true
          },
          "tags": {
            "type": "array",
            "title": "Tags",
            "items": {
              "type": "string",
              "title": "Tag"
            }
          },
          "metadata": {
            "type": "object",
            "title": "Metadata",
            "additionalProperties": {
              "type": "string"
            },
            "x-advanced": true
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "baseUrl": {
            "type": "string",
            "title": "Base Url",
            "format": "uri",
            "x-advanced": true
          },
          "apiKeySecret": {
            "type": "string",
            "title": "Api Key Secret"
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "default": 30000,
            "x-advanced": true
          },
          "maxResponseBytes": {
            "type": "integer",
            "title": "Max Response Bytes",
            "default": 65536,
            "x-advanced": true
          },
          "allowInsecureHttp": {
            "type": "boolean",
            "title": "Allow Insecure Http",
            "default": false,
            "x-advanced": true
          },
          "secrets": {
            "type": "object",
            "title": "Secrets",
            "additionalProperties": {
              "type": "string"
            },
            "x-advanced": true
          }
        }
      }
    }
  }
}

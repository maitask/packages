{
  "input": {
    "provider": "sendgrid",
    "from": {
      "email": "reports@maitask.com",
      "name": "Maitask Reports"
    },
    "to": [
      {
        "email": "product-team@example.com",
        "name": "Product Team"
      }
    ],
    "subject": "Weekly Product Update",
    "template": {
      "text": "{{title}}\n\n{{summary}}\nActive users: {{metrics.activeUsers}}\nNew signups: {{metrics.newSignups}}\nChurn: {{metrics.churn}}",
      "html": "<h1>{{title}}</h1><p>{{summary}}</p><ul><li>Active users: {{metrics.activeUsers}}</li><li>New signups: {{metrics.newSignups}}</li><li>Churn: {{metrics.churn}}</li></ul>",
      "variables": {
        "title": "Product Metrics - Week 42",
        "summary": "Active users increased 8% and churn dropped to 1.4%.",
        "metrics": {
          "activeUsers": "12,540",
          "newSignups": "1,102",
          "churn": "1.4%"
        }
      }
    },
    "tags": [
      "production",
      "weekly-report"
    ],
    "metadata": {
      "workflowId": "weekly-product-report"
    }
  },
  "options": {
    "apiKeySecret": "SENDGRID_API_KEY",
    "timeoutMs": 30000,
    "maxResponseBytes": 65536
  }
}

{
  "name": "@maitask/file-transformer",
  "version": "0.1.1",
  "description": "Convert between file formats: JSON, CSV, XML, YAML, TOML",
  "main": "index.js",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "file",
    "convert",
    "transform",
    "format"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "File Transformer",
  "category": "Data Processing & Transformation",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "File Transformer",
        "description": "Convert between file formats: JSON, CSV, XML, YAML, TOML",
        "category": "Data Processing & Transformation",
        "keywords": [
          "maitask",
          "file",
          "convert",
          "transform",
          "format"
        ]
      },
      "zh": {
        "display_name": "文件转换器",
        "description": "在 JSON、CSV、XML、YAML、TOML 等文件格式之间进行转换。",
        "category": "数据处理与转换",
        "keywords": [
          "文件转换",
          "格式转换",
          "JSON",
          "CSV",
          "XML",
          "YAML",
          "TOML"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "title": "Data"
          },
          "from": {
            "type": "string",
            "title": "From",
            "enum": [
              "json",
              "csv",
              "xml",
              "yaml",
              "toml"
            ]
          },
          "to": {
            "type": "string",
            "title": "To",
            "enum": [
              "json",
              "csv",
              "xml",
              "yaml",
              "toml"
            ]
          }
        },
        "required": [
          "data",
          "from",
          "to"
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "csvDelimiter": {
            "type": "string",
            "title": "CSV Delimiter",
            "default": ","
          },
          "csvHeader": {
            "type": "boolean",
            "title": "Include CSV Header",
            "default": true
          },
          "inferTypes": {
            "type": "boolean",
            "title": "Infer Types",
            "default": true
          },
          "includeParsed": {
            "type": "boolean",
            "title": "Include Parsed Object",
            "default": false,
            "x-advanced": true
          },
          "yamlIndent": {
            "type": "integer",
            "title": "YAML Indent",
            "default": 2,
            "x-advanced": true,
            "minimum": 2
          }
        }
      }
    }
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ]
}

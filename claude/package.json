{
  "name": "@maitask/claude",
  "version": "0.1.1",
  "description": "Anthropic Claude AI models integration for Maitask",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "ai",
    "anthropic",
    "claude",
    "llm",
    "chat"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Claude",
  "category": "AI & Cognitive Services",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Claude",
        "description": "Anthropic Claude AI models integration for Maitask",
        "category": "AI & Cognitive Services",
        "keywords": [
          "maitask",
          "ai",
          "anthropic",
          "claude",
          "llm",
          "chat"
        ]
      },
      "zh": {
        "display_name": "Claude",
        "description": "Anthropic Claude AI 模型集成，用于对话、文本生成、推理和内容处理任务。",
        "category": "AI 与认知服务",
        "keywords": [
          "AI",
          "Claude",
          "Anthropic",
          "大语言模型",
          "聊天",
          "推理"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "claude-sonnet-4-5"
          },
          "maxTokens": {
            "type": "integer",
            "title": "Max Tokens",
            "default": 1024,
            "x-advanced": true,
            "minimum": 1
          },
          "system": {
            "type": "string",
            "title": "System"
          },
          "messages": {
            "type": "array",
            "title": "Messages",
            "items": {
              "type": "object",
              "title": "Messages",
              "properties": {
                "role": {
                  "type": "string",
                  "title": "Role",
                  "enum": [
                    "user",
                    "assistant",
                    "system"
                  ],
                  "default": "user"
                },
                "content": {
                  "type": "string",
                  "title": "Content"
                }
              }
            }
          },
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "x-advanced": true,
            "minimum": 0,
            "maximum": 1
          },
          "text": {
            "type": "string",
            "title": "Text",
            "format": "textarea",
            "x-advanced": true
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false,
            "x-advanced": true
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "title": "Api Key",
            "format": "password"
          },
          "baseUrl": {
            "type": "string",
            "title": "Base URL",
            "format": "uri",
            "x-advanced": true
          },
          "allowPrivateHosts": {
            "type": "boolean",
            "title": "Allow Private Hosts",
            "default": false,
            "x-advanced": true
          },
          "allowInsecureHttp": {
            "type": "boolean",
            "title": "Allow Insecure HTTP",
            "default": false,
            "x-advanced": true
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout (ms)",
            "minimum": 1000,
            "maximum": 300000,
            "default": 60000,
            "x-advanced": true
          },
          "retries": {
            "type": "integer",
            "title": "Retries",
            "minimum": 0,
            "maximum": 5,
            "default": 2,
            "x-advanced": true
          }
        }
      }
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ]
}

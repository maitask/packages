{
  "name": "@maitask/kafka-publisher",
  "version": "0.1.1",
  "description": "Publish messages to Kafka topics via REST proxy",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "kafka",
    "messaging",
    "events",
    "streaming"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Kafka Publisher",
  "category": "Communications & Automation",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Kafka Publisher",
        "description": "Publish messages to Kafka topics via REST proxy",
        "category": "Communications & Automation",
        "keywords": [
          "maitask",
          "kafka",
          "messaging",
          "events",
          "streaming"
        ]
      },
      "zh": {
        "display_name": "Kafka 发布器",
        "description": "通过 REST Proxy 向 Kafka Topic 发布消息，适合事件流和消息集成。",
        "category": "通信与自动化",
        "keywords": [
          "Kafka",
          "消息",
          "事件",
          "流式",
          "Topic",
          "发布"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "title": "Topic",
            "default": "user.events"
          },
          "messages": {
            "type": "array",
            "title": "Messages",
            "items": {
              "type": "object",
              "title": "Messages",
              "properties": {
                "event": {
                  "type": "string",
                  "title": "Event",
                  "default": "signup"
                },
                "userId": {
                  "type": "string",
                  "title": "User Id",
                  "default": "u-1"
                }
              }
            }
          },
          "key": {
            "type": "string",
            "title": "Key",
            "default": "u-1"
          },
          "headers": {
            "type": "object",
            "title": "Headers",
            "properties": {
              "X-Trace-Source": {
                "type": "string",
                "title": "X Trace Source",
                "default": "maitask"
              }
            },
            "x-advanced": true
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "proxyUrl": {
            "type": "string",
            "title": "Proxy Url",
            "default": "https://kafka-proxy.internal",
            "format": "uri"
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "default": 30000,
            "x-advanced": true
          }
        }
      }
    }
  }
}

{
  "url": "https://httpbin.org/post",
  "method": "POST",
  "headers": {
    "Content-Type": "application/json",
    "X-Trace-Id": "maitask-http-request-example"
  },
  "body": {
    "name": "Maitask",
    "operation": "http-request-smoke"
  },
  "timeout": 15000,
  "maxRetries": 2,
  "retryDelay": 500,
  "responseType": "json",
  "validateStatus": [
    200,
    201
  ]
}

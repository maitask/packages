{
  "url": "https://api.maitask.com/health",
  "method": "GET",
  "headers": {
    "Accept": "application/json",
    "X-Trace-Id": "maitask-http-request-example"
  },
  "timeoutMs": 15000,
  "maxResponseBytes": 1048576,
  "maxRedirects": 2,
  "responseType": "json",
  "acceptedStatuses": [
    200
  ],
  "redirect": "error",
  "retry": {
    "maxAttempts": 3,
    "statuses": [
      408,
      429,
      500,
      502,
      503,
      504
    ],
    "initialDelayMs": 250,
    "maxDelayMs": 2000,
    "backoffFactor": 2,
    "jitterRatio": 0.2,
    "respectRetryAfter": true
  }
}

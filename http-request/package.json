{
  "name": "@maitask/http-request",
  "version": "2.0.1",
  "description": "Strict credential-confined HTTP client with bounded redirects, safe retries, and exact response bytes",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "http",
    "request",
    "api",
    "rest",
    "fetch"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "HTTP Request",
  "category": "Web & API Integration",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "HTTP Request",
        "description": "Strict credential-confined HTTP client with bounded redirects, safe retries, and exact response bytes",
        "category": "Web & API Integration",
        "keywords": [
          "maitask",
          "http",
          "request",
          "api",
          "rest",
          "fetch"
        ]
      },
      "zh": {
        "display_name": "HTTP 请求",
        "description": "具备严格凭据隔离、受限重定向、安全重试和精确响应字节的 HTTP 客户端。",
        "category": "Web 与 API 集成",
        "keywords": [
          "HTTP",
          "REST",
          "请求",
          "Fetch",
          "API",
          "重试",
          "校验"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "default": "https://api.maitask.com/health",
            "format": "uri"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ],
            "default": "GET"
          },
          "headers": {
            "type": "object",
            "title": "Headers",
            "additionalProperties": {
              "type": "string"
            },
            "x-advanced": true
          },
          "query": {
            "type": "object",
            "title": "Query Parameters",
            "additionalProperties": true
          },
          "auth": {
            "type": "object",
            "title": "Auth",
            "properties": {
              "type": {
                "type": "string",
                "title": "Type",
                "enum": [
                  "bearer",
                  "basic",
                  "apiKey"
                ]
              },
              "tokenSecret": {
                "type": "string",
                "title": "Token Secret Name"
              },
              "usernameSecret": {
                "type": "string",
                "title": "Username Secret Name"
              },
              "passwordSecret": {
                "type": "string",
                "title": "Password Secret Name"
              },
              "header": {
                "type": "string",
                "title": "Header"
              },
              "valueSecret": {
                "type": "string",
                "title": "Value Secret Name"
              }
            },
            "x-advanced": true
          },
          "json": {
            "type": "object",
            "title": "JSON Body",
            "additionalProperties": true
          },
          "text": {
            "type": "string",
            "title": "Text Body",
            "x-advanced": true
          },
          "bodyBase64": {
            "type": "string",
            "title": "Base64 Body",
            "x-advanced": true
          },
          "form": {
            "type": "object",
            "title": "Form Body",
            "additionalProperties": true,
            "x-advanced": true
          },
          "multipart": {
            "type": "object",
            "title": "Multipart Body",
            "additionalProperties": true,
            "x-advanced": true
          },
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "default": 30000,
            "x-advanced": true
          },
          "maxResponseBytes": {
            "type": "integer",
            "title": "Max Response Bytes",
            "default": 8388608,
            "x-advanced": true
          },
          "maxRedirects": {
            "type": "integer",
            "title": "Max Redirects",
            "default": 5,
            "x-advanced": true
          },
          "responseType": {
            "type": "string",
            "title": "Response Type",
            "enum": [
              "json",
              "text",
              "base64"
            ],
            "default": "json"
          },
          "acceptedStatuses": {
            "type": "array",
            "title": "Accepted Statuses",
            "items": {
              "type": "integer",
              "title": "Accepted Statuses",
              "default": 200
            },
            "x-advanced": true
          },
          "acceptedStatusRange": {
            "type": "object",
            "title": "Accepted Status Range",
            "properties": {
              "min": {
                "type": "integer",
                "title": "Min",
                "default": 200
              },
              "max": {
                "type": "integer",
                "title": "Max",
                "default": 299
              }
            },
            "x-advanced": true
          },
          "redirect": {
            "type": "string",
            "title": "Redirect",
            "enum": [
              "follow",
              "manual",
              "error"
            ],
            "default": "follow"
          },
          "retry": {
            "type": "object",
            "title": "Retry",
            "properties": {
              "maxAttempts": {
                "type": "integer",
                "title": "Max Attempts",
                "default": 3
              },
              "statuses": {
                "type": "array",
                "title": "Statuses",
                "items": {
                  "type": "integer",
                  "title": "Statuses",
                  "default": 408
                }
              },
              "initialDelayMs": {
                "type": "integer",
                "title": "Initial Delay Ms",
                "default": 250
              },
              "maxDelayMs": {
                "type": "integer",
                "title": "Max Delay Ms",
                "default": 2000,
                "x-advanced": true
              },
              "backoffFactor": {
                "type": "integer",
                "title": "Backoff Factor",
                "default": 2
              },
              "jitterRatio": {
                "type": "number",
                "title": "Jitter Ratio",
                "default": 0.2
              },
              "respectRetryAfter": {
                "type": "boolean",
                "title": "Respect Retry After",
                "default": true
              }
            },
            "x-advanced": true
          }
        }
      },
      "options": {
        "type": "object",
        "properties": {
          "timeoutMs": {
            "type": "integer",
            "title": "Timeout Ms",
            "default": 30000,
            "x-advanced": true
          },
          "maxResponseBytes": {
            "type": "integer",
            "title": "Max Response Bytes",
            "default": 8388608,
            "x-advanced": true
          },
          "maxRedirects": {
            "type": "integer",
            "title": "Max Redirects",
            "default": 5,
            "x-advanced": true
          },
          "allowInsecureHttp": {
            "type": "boolean",
            "title": "Allow Insecure Http",
            "default": false,
            "x-advanced": true
          },
          "allowedHosts": {
            "type": "array",
            "title": "Allowed Hosts",
            "items": {
              "type": "string"
            },
            "x-advanced": true
          },
          "secrets": {
            "type": "object",
            "title": "Secrets",
            "additionalProperties": {
              "type": "string"
            },
            "x-advanced": true
          }
        }
      }
    }
  }
}

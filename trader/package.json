{
  "name": "@maitask/trader",
  "version": "1.0.1",
  "description": "Deterministic market analysis, simulation, paper execution, and controlled exchange trading",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "keywords": [
    "maitask",
    "trading",
    "binance",
    "aster",
    "okx",
    "futures",
    "backtesting",
    "paper-trading",
    "exchange"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "display_name": "Trader",
  "category": "Finance & Trading",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Trader",
        "description": "Deterministic market analysis, simulation, paper execution, and controlled exchange trading",
        "category": "Finance & Trading",
        "keywords": [
          "maitask",
          "trading",
          "binance",
          "aster",
          "okx",
          "futures",
          "backtesting",
          "paper-trading",
          "exchange"
        ]
      },
      "zh": {
        "display_name": "交易器",
        "description": "在 Maitask 中执行确定性市场分析、回测、模拟交易和受控交易所操作。",
        "category": "金融与交易",
        "keywords": [
          "交易",
          "Binance",
          "合约",
          "现货",
          "回测",
          "模拟交易",
          "交易所"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "title": "Action",
            "default": "marketSnapshot"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "default": "BTCUSDT"
          },
          "interval": {
            "type": "string",
            "title": "Interval",
            "default": "5m"
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 120
          },
          "exchange": {
            "type": "object",
            "title": "Exchange",
            "properties": {
              "provider": {
                "type": "string",
                "title": "Provider",
                "default": "binance"
              },
              "market": {
                "type": "string",
                "title": "Market",
                "default": "spot"
              },
              "environment": {
                "type": "string",
                "title": "Environment",
                "default": "testnet"
              }
            }
          }
        }
      }
    }
  }
}

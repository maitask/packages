{
  "name": "@maitask/cf-proxy",
  "version": "0.1.1",
  "description": "Validated read-only transport for GitHub resources and container registry content",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "author": "Maitask Team <team@maitask.com>",
  "license": "MIT",
  "homepage": "https://github.com/maitask/packages/tree/main/cf-proxy",
  "repository": {
    "type": "git",
    "url": "https://github.com/maitask/packages.git",
    "directory": "cf-proxy"
  },
  "bugs": {
    "url": "https://github.com/maitask/packages/issues"
  },
  "keywords": [
    "maitask",
    "cloudflare",
    "proxy",
    "cdn",
    "github",
    "docker",
    "registry",
    "read-only",
    "security"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "example.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "display_name": "Cloudflare Proxy",
  "category": "Web & API Integration",
  "maitask": {
    "locales": {
      "en": {
        "display_name": "Cloudflare Proxy",
        "description": "Validated read-only transport for GitHub resources and container registry content",
        "category": "Web & API Integration",
        "keywords": [
          "maitask",
          "cloudflare",
          "proxy",
          "cdn",
          "github",
          "docker",
          "registry",
          "read-only",
          "security"
        ]
      },
      "zh": {
        "display_name": "Cloudflare 代理",
        "description": "用于读取 GitHub 资源和容器 Registry 内容的受控只读传输工具，具备逐跳校验与凭据隔离。",
        "category": "Web 与 API 集成",
        "keywords": [
          "Cloudflare",
          "代理",
          "只读",
          "GitHub",
          "Docker",
          "Registry",
          "安全"
        ]
      }
    },
    "schemas": {
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "default": "https://registry-1.docker.io/v2/library/ubuntu/manifests/latest",
            "format": "uri"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD"
            ],
            "default": "GET"
          },
          "headers": {
            "type": "object",
            "title": "Headers",
            "properties": {
              "Accept": {
                "type": "string",
                "title": "Accept",
                "default": "application/vnd.oci.image.manifest.v1+json"
              }
            },
            "x-advanced": true
          },
          "config": {
            "type": "object",
            "title": "Config",
            "properties": {
              "restrictPaths": {
                "type": "boolean",
                "title": "Restrict Paths",
                "default": true
              },
              "allowedPaths": {
                "type": "array",
                "title": "Allowed Paths",
                "items": {
                  "type": "string",
                  "title": "Allowed Paths",
                  "default": "/v2/library"
                }
              },
              "maxRedirects": {
                "type": "integer",
                "title": "Max Redirects",
                "default": 4,
                "x-advanced": true
              },
              "timeoutMs": {
                "type": "integer",
                "title": "Timeout Ms",
                "default": 30000,
                "x-advanced": true
              },
              "maxResponseBytes": {
                "type": "integer",
                "title": "Max Response Bytes",
                "default": 8388608,
                "x-advanced": true
              }
            }
          }
        }
      }
    }
  }
}
